# Template only: copy this file to .env.local and put the real values there.
# Next.js does not read .env.example, and this file is committed, so keep secrets out of it.

# Postgres connection string. On Supabase use the "Transaction pooler" URI (port 6543),
# e.g. postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Public URL of the site (used in emails and QR codes). No trailing slash.
# Production: https://velvetpalms.beamxsolutions.com
SITE_URL=http://localhost:3000

# Optional. Serve the site under a path instead of the domain root, e.g. /velvetpalms.
# NEXT_PUBLIC_BASE_PATH=

# Optional. Extra hosts allowed to submit the booking form, only if another site proxies to this one.
# ALLOWED_ORIGINS=

# Admin login for /admin (browser will prompt for these)
ADMIN_USER=
ADMIN_PASSWORD=

# Confirmation emails via Resend (optional: if blank, emails are skipped and logged)
RESEND_API_KEY=
EMAIL_FROM=Velvet Palms <reservations@yourdomain.com>
