# Template only: copy this file to .env.local and put the real values there.
# Next.js does not read .env.example, and this file is committed, so keep secrets out of it.

# Postgres connection string. On Supabase use the "Transaction pooler" URI (port 6543),
# e.g. postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Public URL of the site, including the /velvetpalms path (used in emails and QR codes). No trailing slash.
# Production: https://beamxsolutions.com/velvetpalms
SITE_URL=http://localhost:3000/velvetpalms

# Optional. The site is served under /velvetpalms by default. Set to an empty value to serve it at the root.
# NEXT_PUBLIC_BASE_PATH=/velvetpalms

# Optional. Hosts allowed to submit the booking form (default: beamxsolutions.com,www.beamxsolutions.com).
# ALLOWED_ORIGINS=beamxsolutions.com,www.beamxsolutions.com

# Admin login for /admin (browser will prompt for these)
ADMIN_USER=
ADMIN_PASSWORD=

# Confirmation emails via Resend (optional: if blank, emails are skipped and logged)
RESEND_API_KEY=
EMAIL_FROM=Velvet Palms <reservations@yourdomain.com>
